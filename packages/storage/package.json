{
  "name": "@paldora/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Private object storage: an interface, an S3-compatible adapter, and an in-memory fake for tests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0"
  },
  "devDependencies": {
    "@paldora/config": "workspace:*",
    "vitest": "4.1.11"
  }
}
