{
  "name": "@paldora/firebase-prototype",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated Firestore migration experiments; never imported by the live API.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:prototype": "vitest run integration.test"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@paldora/validation": "workspace:*",
    "firebase-admin": "14.5.0"
  }
}
