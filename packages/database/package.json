{
  "name": "@paldora/database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations, and connection pool.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src drizzle.config.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration.test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@paldora/config": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@paldora/domain": "workspace:*",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "vitest": "4.1.11"
  }
}
