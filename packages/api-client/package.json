{
  "name": "@paldora/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Paldora HTTP client derived from the shared route registry.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@paldora/domain": "workspace:*",
    "@paldora/validation": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
