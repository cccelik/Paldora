{
  "name": "paldora",
  "version": "0.0.0",
  "private": true,
  "description": "A box for your people: a privacy-first living scrapbook for real friends and private communities.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node scripts/with-test-database.mjs pnpm turbo run test:integration --concurrency=1",
    "test:e2e": "playwright test -c apps/web/e2e/playwright.config.ts",
    "contract:generate": "pnpm --filter @paldora/validation contract:generate",
    "contract:check": "pnpm --filter @paldora/validation contract:check",
    "tokens:generate": "pnpm --filter @paldora/tokens tokens:generate",
    "tokens:check": "pnpm --filter @paldora/tokens tokens:check",
    "db:generate": "pnpm --filter @paldora/database db:generate",
    "db:migrate": "pnpm --filter @paldora/database db:migrate",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,storage --project demo-paldora",
    "firebase:emulators:exec": "firebase emulators:exec --only auth,firestore,storage --project demo-paldora",
    "firebase:rules:check": "firebase emulators:exec --only auth,firestore,storage --project demo-paldora 'node scripts/check-firebase-rules.mjs'",
    "scan:client-bundle": "node scripts/scan-client-bundle.mjs apps/web/.next/static",
    "test:e2e:full": "turbo run build --filter=@paldora/api --filter=@paldora/worker --filter=@paldora/web^... && node scripts/with-test-database.mjs playwright test -c apps/web/e2e/playwright.fullstack.config.ts",
    "test:e2e:personalization": "turbo run build --filter=@paldora/api --filter=@paldora/worker --filter=@paldora/web^... && node scripts/with-test-database.mjs playwright test -c apps/web/e2e/playwright.personalization.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "firebase-tools": "15.34.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "6.0.2"
  }
}
