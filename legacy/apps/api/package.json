{
  "name": "@paldora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "seed:demo": "tsx --env-file=../../.env src/seed-demo.ts",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@paldora/auth": "workspace:*",
    "@paldora/config": "workspace:*",
    "@paldora/database": "workspace:*",
    "@paldora/domain": "workspace:*",
    "@paldora/observability": "workspace:*",
    "@paldora/storage": "workspace:*",
    "@paldora/validation": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "bullmq": "6.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "drizzle-orm": "0.45.2",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.3",
    "tsx": "4.20.5",
    "vitest": "4.1.11"
  }
}
