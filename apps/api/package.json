{
  "name": "@paldora/api",
  "version": "0.0.0",
  "private": true,
  "description": "Paldora versioned REST API (NestJS modular monolith).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test",
    "provision": "tsx --env-file-if-exists=../../.env src/provisioning/provision.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@paldora/config": "workspace:*",
    "@paldora/database": "workspace:*",
    "@paldora/domain": "workspace:*",
    "@paldora/observability": "workspace:*",
    "@paldora/storage": "workspace:*",
    "@paldora/validation": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "drizzle-orm": "0.45.2",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "@paldora/personalization": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.3",
    "tsx": "4.20.5",
    "vitest": "4.1.11"
  }
}
