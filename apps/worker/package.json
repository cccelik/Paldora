{
  "name": "@paldora/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Paldora background worker: media processing, deletion, and maintenance jobs.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test --no-file-parallelism"
  },
  "dependencies": {
    "@paldora/config": "workspace:*",
    "@paldora/database": "workspace:*",
    "@paldora/domain": "workspace:*",
    "@paldora/observability": "workspace:*",
    "@paldora/storage": "workspace:*",
    "@paldora/validation": "workspace:*",
    "bullmq": "6.2.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "tsx": "4.20.5",
    "vitest": "4.1.11"
  }
}
