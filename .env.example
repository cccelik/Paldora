NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server verification and admin-only demo provisioning
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
# Use an inbox you control. Supabase's default SMTP only delivers to project team members.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USERNAME=demo_friend
DEMO_DISPLAY_NAME=Paldora Friend
# Optional second verified account for testing friend requests and Box invitations.
# Set all four values or leave all four empty.
DEMO_FRIEND_EMAIL=
DEMO_FRIEND_PASSWORD=
DEMO_FRIEND_USERNAME=
DEMO_FRIEND_DISPLAY_NAME=

# PostgreSQL (local Docker defaults only; change in deployed environments)
DATABASE_URL=postgresql://paldora:paldora_dev_only@localhost:5432/paldora

# Redis
REDIS_URL=redis://localhost:6379
MEDIA_JOB_QUEUE_NAME=paldora-jobs

# S3-compatible private object storage (required when media is enabled)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=paldora-private
S3_ACCESS_KEY_ID=paldora_minio
S3_SECRET_ACCESS_KEY=paldora_minio_dev_only
S3_FORCE_PATH_STYLE=true
