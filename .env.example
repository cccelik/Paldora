# Copy to .env for local development. Never commit .env.
# local | test | staging | production. Staging and production enforce HTTPS
# origins and reject *_dev_only credentials.
PALDORA_ENV=local
LOG_LEVEL=info

# --- Public: safe to inline into the browser bundle -------------------------
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin of private media signed URLs (the S3/MinIO endpoint browsers reach).
# Allowed by the CSP for uploads and images.
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000

# --- Server only: API and worker. Never expose to the web app. --------------
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

DATABASE_URL=postgresql://paldora:paldora_dev_only@localhost:5432/paldora
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# Use a distinct queue per environment that shares a Redis instance.
JOB_QUEUE_NAME=paldora-jobs
WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=1000

# Private S3-compatible storage (API signs URLs; the worker processes media).
# Local MinIO from infrastructure/docker-compose.yml. Never public buckets.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=paldora-private
S3_ACCESS_KEY_ID=paldora_minio
S3_SECRET_ACCESS_KEY=paldora_minio_dev_only
S3_FORCE_PATH_STYLE=true

# --- Trusted provisioning script only (pnpm --filter @paldora/api provision).
# Never give this key to the API, worker, web, or native apps.
SUPABASE_SERVICE_ROLE_KEY=
# Worker-only privileged Auth deletion key. Prefer a Supabase secret key;
# the legacy service-role key above remains a fallback during migration.
SUPABASE_SECRET_KEY=
# Optional local demo accounts for `provision --demo`.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USERNAME=
DEMO_DISPLAY_NAME=
DEMO_FRIEND_EMAIL=
DEMO_FRIEND_PASSWORD=
DEMO_FRIEND_USERNAME=
DEMO_FRIEND_DISPLAY_NAME=
