NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL (local Docker defaults only; change in deployed environments)
DATABASE_URL=postgresql://paldora:paldora_dev_only@localhost:5432/paldora

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible private object storage (required when media is enabled)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
