                "boxId": { "type": "string" },
                "boxName": { "type": "string" },
                "postId": { "type": "string" },
                "canInteract": { "type": "boolean" }
              },
              "required": ["boxId", "boxName", "postId", "canInteract"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "authorUid",
          "audience",
          "sections",
          "mediaAssetIds",
          "createdAt",
          "updatedAt",
          "canEdit",
          "contexts"
