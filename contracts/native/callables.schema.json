{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paldora native callable contract",
  "description": "Firebase callable functions (europe-west4). Generated from packages/validation/src/native; do not edit.",
  "rateLimitWindowMs": 3600000,
  "error": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "ok",
          "cancelled",
          "unknown",
          "invalid-argument",
          "deadline-exceeded",
          "not-found",
          "already-exists",
          "permission-denied",
          "unauthenticated",
          "resource-exhausted",
          "failed-precondition",
          "aborted",
          "out-of-range",
          "unimplemented",
          "internal",
          "unavailable",
          "data-loss"
        ]
      },
      "message": { "type": "string" },
      "details": {
        "type": "object",
        "properties": { "reason": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "required": ["code", "message"],
    "additionalProperties": false
  },
  "errorReasons": [
    "SIGN_IN_REQUIRED",
    "SESSION_ENDED",
    "INVALID_INPUT",
    "RATE_LIMITED"
  ],
  "callables": {
    "beginBoxDeletion": {
      "input": {
        "type": "object",
        "properties": {
          "boxId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "confirmName": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "required": ["boxId", "confirmName"]
      },
      "output": {
        "type": "object",
        "properties": { "jobId": { "type": "string" } },
        "required": ["jobId"],
        "additionalProperties": false
      },
      "errors": [
        "failed-precondition",
        "invalid-argument",
        "not-found",
        "resource-exhausted",
        "unauthenticated"
      ],
      "limit": { "scope": "beginBoxDeletion", "perHour": 5 }
    },
    "boxDeletionStatus": {
      "input": {
        "type": "object",
        "properties": {
          "boxId": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "required": ["boxId"]
      },
      "output": {
        "type": "object",
        "properties": {
          "boxId": { "type": "string" },
          "generation": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": [
              "blockers",
              "derived_refs",
              "deliveries",
              "reports",
              "invitations",
              "members",
              "post_pointers",
              "tree",
              "complete"
            ]
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["boxId", "generation", "phase", "updatedAt"],
        "additionalProperties": false
      },
      "errors": [
        "invalid-argument",
        "not-found",
        "resource-exhausted",
        "unauthenticated"
      ],
      "limit": { "scope": "boxDeletionStatus", "perHour": 120 }
    },
    "createLifeUpdate": {
      "input": {
        "type": "object",
        "properties": {
          "audience": {
            "oneOf": [
              {
                "type": "object",
