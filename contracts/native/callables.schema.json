                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "boxes" },
                  "boxIds": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": ["type", "boxIds"],
                "additionalProperties": false
              }
            ]
          },
          "sections": {
            "type": "object",
            "properties": {
              "lifeLately": { "type": "string", "maxLength": 2000 },
              "workOrUniversity": { "type": "string", "maxLength": 2000 },
              "travel": { "type": "string", "maxLength": 2000 },
              "currentlyInto": { "type": "string", "maxLength": 2000 },
              "listeningTo": { "type": "string", "maxLength": 2000 },
              "watching": { "type": "string", "maxLength": 2000 },
              "reading": { "type": "string", "maxLength": 2000 },
              "excitedAbout": { "type": "string", "maxLength": 2000 },
              "whatsNext": { "type": "string", "maxLength": 2000 }
            },
            "additionalProperties": false
          },
          "mediaAssetIds": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["audience"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "required": ["id"],
        "additionalProperties": false
      },
      "errors": [
        "invalid-argument",
        "not-found",
        "resource-exhausted",
        "unauthenticated"
      ],
      "limit": { "scope": "createLifeUpdate", "perHour": 30 }
    },
